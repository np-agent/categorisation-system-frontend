# Frontend site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SuperTokens / auth API base URL (no trailing slash)
# Auth routes are served at {NEXT_PUBLIC_API_BASE_URL}/auth
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Backend should send password-reset emails to:
#   {NEXT_PUBLIC_SITE_URL}/reset-password?token=...&rid=emailpassword
